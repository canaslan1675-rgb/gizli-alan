<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      `full` flavor only: SECOND PHONE (see docs/PLAY_COMPLIANCE.md). A
      DeviceAdminReceiver used ONLY as profile owner of a work profile the user
      creates. It requests no device-admin policies and removes itself if
      activated as a main-profile device admin. No extra permissions.
    -->
    <uses-feature android:name="android.software.managed_users" android:required="false" />
    <uses-feature android:name="android.software.device_admin" android:required="false" />

    <application>
        <!-- Second phone: profile-owner admin (work profile only). -->
        <receiver
            android:name=".secondphone.ProfileAdminReceiver"
            android:label="@string/profile_admin_label"
            android:description="@string/profile_admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/profile_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>
        <!-- Runs inside the new work profile when provisioning succeeds. -->
        <activity
            android:name=".secondphone.ProvisioningDoneActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.app.action.PROVISIONING_SUCCESSFUL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Signed request trampoline; disabled by default, enabled only
             inside the work profile by ProfileSetup. -->
        <activity
            android:name=".secondphone.ProfileActionActivity"
            android:enabled="false"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="com.offerforge.gizlialan.secondphone.PROFILE_ACTION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Work profile only: periodic re-hide while the vault is locked (#45). -->
        <service
            android:name=".secondphone.HideSweepJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
    </application>
    <queries>
        <!-- Second phone: list launchable apps (main + own work profile) for
             the in-vault home grid and the "add app" picker. Not QUERY_ALL_PACKAGES. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>
</manifest>
