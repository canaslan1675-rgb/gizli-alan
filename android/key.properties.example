# Template for release signing. Copy to android/key.properties on the OWNER's
# machine only and fill in real values. android/key.properties and keystores
# are git-ignored — never commit them, never paste them into issues or chat.
#
# storeFile is relative to the android/ directory (or an absolute path).
storeFile=/absolute/path/outside/the/repo/gizlialan-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
